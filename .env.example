# Copy to apps/api/.env. No API secrets required for these public sources.
HOST=127.0.0.1
PORT=3001
CORS_ORIGIN=http://localhost:5173
# Comma-separated Greenhouse board identifiers; up to 5. Empty disables Greenhouse.
GREENHOUSE_BOARDS=
# Optional AI: public job text only, never resumes. Leave disabled until reviewed.
AI_ENABLED=false
OPENAI_API_KEY=
AI_MAX_REQUEST_USD=0.01
AI_DAILY_BUDGET_USD=0.10
